# Hugo output directory (if using `hugo` without `-d`)
public/
resources/
  
# Hugo cache
.cache/
  
# Build artifacts
*.tar.gz
*.zip
*.DS_Store

# OS-specific
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*.bak
*.tmp

# Node modules (if using Tailwind, PostCSS, etc.)
node_modules/

# Files generated by Hugo server --navigateToChanged
hugo_stats.json

# Optional: if using Netlify or other deployment platforms
netlify.toml

